{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "repository": {
      "enum": [
        "quickclip",
        "quickmusic",
        "quickrem",
        "quickspot",
        "quicktiler",
        "quickts"
      ]
    },
    "requirements": { "type": "string" }
  }
}
