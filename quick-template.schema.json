{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "revision"],
  "properties": {
    "$schema": { "type": "string" },
    "repository": { "const": "Ghost-Assembly/quick-template" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
